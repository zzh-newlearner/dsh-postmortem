{
  "name": "@huichangzz/dsh-postmortem",
  "version": "0.9.1",
  "description": "Explain failed DeepSeek Harness agent runs locally, then produce a redacted recovery plan. No model required.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "scripts", "schemas", "datasets", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzh-newlearner/dsh-postmortem.git"
  },
  "homepage": "https://github.com/zzh-newlearner/dsh-postmortem#readme",
  "bugs": {
    "url": "https://github.com/zzh-newlearner/dsh-postmortem/issues"
  },
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "agent-debugging", "agent-observability", "llm-agents", "incident-response", "postmortem", "typescript"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "demo": "node scripts/demo.mjs",
    "selfcheck:dsh": "npm run build && node scripts/dsh-selfcheck.mjs",
    "eval:models": "node scripts/model-eval.mjs",
    "eval:paired": "npm run build && node scripts/paired-eval.mjs",
    "eval:verified": "npm run build && node scripts/verified-eval.mjs"
  }
}
